#!/usr/bin/env ruby
#
# reduce_claude - Spinel repro reducer (see REDUCE.md).
#
# Given input.rb where Ruby passes and Spinel fails during compilation or
# runtime, shrink it while preserving the same normalized failure.
# Two stages, biggest cuts first:
#   1. Strip full-line comments and blank lines in one shot (free, no parse
#      needed).
#   2. Prism-guided delta debugging: parse with Prism (Ruby's own parser, no
#      gem/Bundler dependency), walk the tree, and at each meaningful node
#      (class, module, def, constant assignment, alias, statement list, or
#      individual statement) try deleting it or swapping in a placeholder
#      literal; for a method body, also try each of the method's own
#      parameter names as a passthrough stub. Every pass recollects
#      candidates fresh, sorts biggest-first, and tests a batch of `--jobs`
#      candidates concurrently via plain threads (the child `ruby`/`spinel`
#      processes release the GVL while running, so this is genuine
#      parallelism without needing an external `xargs` dance).
# There is deliberately no separate line-block-deletion phase: the AST walk
# already tries the biggest node first on every pass, so it captures the
# same "biggest wins first" cuts (whole modules, whole methods) without an
# extra phase or line-alignment luck.
# A final RuboCop pass tidies the result.
#
# Usage: bin/reduce_claude [options] input.rb

require "prism"
require "tempfile"
require "tmpdir"
require "optparse"
require "open3"
require "etc"
require "digest"

RUBY_RUN_TIMEOUT = 10
COMPILE_TIMEOUT = 30
BIN_RUN_TIMEOUT = 10
RUBOCOP_TIMEOUT = 30
# RuboCop resolves .rubocop.yml by walking up from the *target file's own
# directory*, not from cwd - so cleanup silently produces zero changes
# (misparsing modern syntax like endless methods under stone-age default
# settings) whenever -o points somewhere outside the repo, e.g. a scratch
# directory. Pin it explicitly so cleanup works regardless of -o.
ROOT_RUBOCOP_CONFIG = File.expand_path("../.rubocop.yml", __dir__)

# A hard structural boundary, independent of (and stronger than) reasoning
# about which candidate types could theoretically reach the assertion: put
# `# reduce:freeze` on its own comment line right before the raise/marker
# line, and everything from that line to EOF is split off as `tail` and
# never parsed, never offered as a candidate, never even seen by RuboCop -
# it's carried through untouched and reappended after every edit.
FREEZE_MARKER_RE = /^#.*reduce:freeze\b.*$\n?/

# Splits source into [head, tail] at the freeze marker (tail includes the
# marker line itself). No marker present -> [source, ""], i.e. unchanged
# behavior for files that don't opt in.
def split_frozen_tail(source)
  m = FREEZE_MARKER_RE.match(source)
  return [source, ""] unless m

  [source[0...m.begin(0)], source[m.begin(0)..]]
end

def split_header(source)
  lines = source.lines
  idx = 0
  idx += 1 while idx < lines.length && (lines[idx].strip.empty? || lines[idx].strip.start_with?("#"))
  [lines[0...idx].join, lines[idx..].join]
end
PLACEHOLDERS = ["", "nil", "0", "1", "true", "false", '""', "[]", "{}", ":x", "self"].freeze
TARGET_NODE_CLASSES = [
  Prism::ClassNode,
  Prism::ModuleNode,
  Prism::ConstantWriteNode,
  Prism::ConstantPathWriteNode,
  Prism::AliasMethodNode,
  Prism::RescueNode,
  Prism::WhenNode,
].freeze

# Defensive only: this script itself never touches Bundler, so ENV stays
# clean by default. But if a user habitually launches it as `bundle exec
# ruby bin/reduce_claude ...`, `bundle exec` itself sets RUBYOPT to force
# `-r bundler/setup` plus several BUNDLE_*/RUBYLIB vars before our script
# even starts, and every `ruby`/`spinel`/`bundle` child we spawn below
# would inherit that. Scrub the whole family on every spawn so a candidate
# under test never fails just because this repo's Gemfile doesn't declare
# whatever stdlib gem it happens to require (e.g. "ostruct").
CLEAN_ENV = %w[RUBYOPT BUNDLE_GEMFILE BUNDLE_LOCKFILE RUBYLIB BUNDLER_SETUP
  BUNDLE_BIN_PATH BUNDLER_VERSION].to_h { [_1, nil] }.freeze

# Runs a command with a wall-clock timeout, killing it if it overruns.
# Returns [Process::Status or nil, stdout, stderr]; nil status means timeout.
def run_with_timeout(cmd, timeout)
  Open3.popen3(CLEAN_ENV, *cmd) do |stdin, stdout, stderr, wait_thr|
    stdin.close
    out_reader = Thread.new { stdout.read }
    err_reader = Thread.new { stderr.read }
    if wait_thr.join(timeout)
      [wait_thr.value, out_reader.value, err_reader.value]
    else
      Process.kill("KILL", wait_thr.pid) rescue nil
      wait_thr.join
      out_reader.kill
      err_reader.kill
      [nil, "", "TIMEOUT"]
    end
  end
end

# one-liners
def ruby_syntax_valid?(source) = Prism.parse(source).success?

# Process::Status#exitstatus is nil when the process died from an
# uncaught signal (e.g. a segfault) instead of calling exit - a real,
# AGENTS.md-recognized Spinel failure mode, not something to crash on.
# Return a negative, exit-code-incompatible number for that case so it
# still round-trips through equality/zero? checks correctly.
def effective_exit_code(status) = status.exitstatus || -status.termsig

# Human-readable byte size, e.g. 445 -> "445b", 4523 -> "4.5k".
def humanize_bytes(n) = (n < 1000) ? "#{n}b" : format("%.1fk", n / 1000.0)

# Signed human-readable byte delta, e.g. -3800 -> "-3.8k", 2 -> "+2b".
def humanize_delta(n) = "#{n.negative? ? "-" : "+"}#{humanize_bytes(n.abs)}"

# Tracks the global stop conditions: an accepted-edit budget, a total
# candidates-tried budget, a wall-clock deadline, and (via SIGINT) a
# user-requested stop. Shared across all stages so `--limit`/
# `--max-attempts`/`--max-minutes` bound the whole run, not just one stage.
class Budget
  def initialize(limit:, max_attempts:, max_minutes:)
    @limit = limit
    @max_attempts = max_attempts
    @deadline = max_minutes ? Time.now + (max_minutes * 60) : nil
    @accepted = 0
    @attempts = 0
    @start = Time.now
    @interrupted = false
    Signal.trap("INT") { @interrupted = true }
  end

  attr_reader :accepted, :attempts, :start

  def accept! = @accepted += 1
  def tried!(n) = @attempts += n
  def elapsed = Time.now - @start

  def exhausted?
    return true if @interrupted
    return true if @limit && @accepted >= @limit
    return true if @max_attempts && @attempts >= @max_attempts
    return true if @deadline && Time.now >= @deadline

    false
  end

  def stop_reason
    return "Ctrl-C" if @interrupted
    return "reached --limit #{@limit} accepted reductions" if @limit && @accepted >= @limit
    return "reached --max-attempts #{@max_attempts}" if @max_attempts && @attempts >= @max_attempts
    return "reached --max-minutes deadline" if @deadline && Time.now >= @deadline

    "full pass with no accepted reduction"
  end
end

# One normalized Spinel failure, independent of temporary paths and line numbers.
Failure = Struct.new(:kind, :marker, :output)

# Compiles+runs a candidate under Ruby and Spinel and preserves the baseline
# compile, warning, or runtime failure. Runtime raises use their source marker;
# compiler failures use a normalized diagnostic and generated function name.
# Thread-safe: every call spawns its own subprocesses via fresh tempfiles,
# and baseline state is set once during calibrate! and only read afterward.
class Oracle
  attr_reader :failure, :marker, :prefix, :spinel_bin

  # tail: the frozen suffix (see split_frozen_tail), appended internally
  # before every run so callers only ever deal with the reducible `head`.
  def initialize(spinel_bin:, prefix: "", tail: "")
    @prefix = prefix
    @spinel_bin = spinel_bin
    @tail = tail
  end

  def calibrate!(head)
    source = prefix + head + @tail
    unless run_ruby(source)
      abort "baseline does not run cleanly under plain ruby; nothing to reduce"
    end

    @marker = source[/raise\s+"([^"]*)"/, 1]
    @failure = spinel_failure(source)
    abort "baseline passes under spinel; nothing to reduce" unless failure

    @marker = nil unless failure.kind == :runtime && failure.marker.include?(marker.to_s)
    if marker && !failure.output.include?(marker)
      abort "marker #{marker.inspect} not found in baseline spinel output; fix the raise message"
    end

    warn "baseline: #{source.bytesize}b (#{humanize_bytes(source.bytesize)}), " \
      "ruby ok, spinel #{failure.kind} #{failure.marker}"
  end

  # Does this candidate head still show the same bug signature? Safe to
  # call concurrently from multiple threads.
  def reproduces?(head)
    source = prefix + head + @tail
    return false unless run_ruby(source)

    current = spinel_failure(source)
    return false unless current
    return false unless current.kind == failure.kind
    return false unless current.marker == failure.marker
    return false if marker && !current.output.include?(marker)

    true
  end

  private

  def run_ruby(source)
    with_tempfile(source) do |path|
      status, = run_with_timeout(["ruby", path], RUBY_RUN_TIMEOUT)
      status&.success?
    end
  end

  def spinel_failure(source)
    with_tempfile(source) do |path|
      Tempfile.create("reduce-claude-bin") do |bin|
        bin.close
        File.delete(bin.path)
        compile_status, compile_out, compile_err = run_with_timeout([spinel_bin, path, "-o", bin.path], COMPILE_TIMEOUT)
        compile_out = strip_routine_notice(compile_out, path, bin.path)
        compile_err = strip_routine_notice(compile_err, path, bin.path)
        compile_output = "#{compile_out}#{compile_err}"
        unless compile_status&.success? && File.executable?(bin.path)
          next Failure.new(:compile, diagnostic_marker(compile_output), compile_output)
        end

        warning = compile_output.strip
        next Failure.new(:warning, diagnostic_marker(warning), warning) unless warning.empty?

        run_status, out, err = run_with_timeout([bin.path], BIN_RUN_TIMEOUT)
        next nil if run_status&.success?

        output = "#{out}#{err}"
        failure_marker = (marker && output.include?(marker)) ? marker : runtime_marker(output)
        Failure.new(:runtime, failure_marker, output)
      ensure
        File.delete(bin.path) if bin.path && File.exist?(bin.path)
      end
    end
  end

  def with_tempfile(source)
    Tempfile.create(["reduce-claude", ".rb"]) do |f|
      f.write(source)
      f.flush
      yield f.path
    end
  end

  # spinel prints "input -> output" to stderr on every successful compile,
  # even with no bug present - that's routine, not a warning. Strip it out
  # (matched exactly against this invocation's own paths, not a loose
  # pattern) so a real compile warning can't be masked by it, and so this
  # routine line is never mistaken for one.
  def strip_routine_notice(text, input_path, output_path)
    notice = "#{input_path} -> #{output_path}"
    text.lines.reject { |l| l.strip == notice }.join
  end

  # Keep compiler failure identity stable as candidates change line numbers and
  # temporary paths. Include the generated function plus normalized compiler
  # error/warning/note lines, so reductions preserve details such as expected
  # and actual C types instead of matching only the first broad diagnostic.
  def diagnostic_marker(output)
    lines = output.lines.map(&:strip).reject(&:empty?)
    function = lines.find { _1.include?("In function") }
    function = function.sub(/\A.*?: In function /, "function ") if function

    diagnostics = lines.filter_map { normalized_diagnostic(_1) }
    diagnostics << normalized_spinel_line(lines) if diagnostics.empty?
    [function, *diagnostics].compact.join(" | ").gsub(/node \d+/, "node N")
  end

  def normalized_diagnostic(line)
    return unless (match = /\b(fatal error|error|warning|note):\s*(.*)\z/.match(line))

    "#{match[1]}: #{match[2]}"
  end

  def normalized_spinel_line(lines)
    line = lines.find { _1.start_with?("spinel:") } || lines.first.to_s
    line.sub(/\Aspinel:\s+\S+:\d+:\s*/, "spinel: ")
  end

  def runtime_marker(output)
    line = output.lines.find { _1.include?("RuntimeError") }
    line ? line.strip : output.lines.find { !_1.strip.empty? }.to_s.strip
  end
end

# Thread-safe "have we tried this exact full-source text before" cache,
# shared between the line-strip and AST stages, so an oscillation (the
# same state getting re-proposed forever) can never loop: a candidate
# whose resulting source was already seen this run is rejected outright.
class SeenSet
  def initialize
    @digests = {}
    @mutex = Mutex.new
  end

  def novel?(source)
    digest = Digest::SHA256.hexdigest(source)
    @mutex.synchronize do
      return false if @digests[digest]

      @digests[digest] = true
    end
  end
end

# Progress reporting: per-accept lines plus periodic heartbeats so a long
# the run doesn't look silent/hung: each row shows both how many
# reductions have been accepted and how many candidates have been tried
# in total. Fixed-width columns (elapsed, accepted/tried, stage, label,
# resulting size, resulting line count, bytes removed) so a run's lines
# stay aligned and scan easily. Shows only the *result* of each edit, not
# the pre-edit size, since the previous row already said what it was.
class Reporter
  ROW_FORMAT = "[%6.1fs] #%-4d/%-6d %-6s %-28s %8s %5s  %8s"

  def initialize(budget:, quiet:)
    @budget = budget
    @quiet = quiet
  end

  def accepted(stage, label, before_source, after_source)
    return if @quiet

    after_b, after_l = after_source.bytesize, after_source.lines.length
    delta = after_b - before_source.bytesize
    warn format(ROW_FORMAT, elapsed, @budget.accepted, @budget.attempts, stage, label[0, 28],
      humanize_bytes(after_b), "#{after_l}L", humanize_delta(delta))
  end

  def tried(n) = @budget.tried!(n)

  def line(msg) = warn(msg) unless @quiet

  private

  def elapsed = @budget.elapsed.round(1)
end

# Stage 1: a single, free bulk strip of full-line comments and blank
# lines. No parser needed, and it never fails to be worth trying since
# removing dead text can't change program behavior.
class LineReducer
  def initialize(oracle:, budget:, reporter:, seen:)
    @oracle = oracle
    @budget = budget
    @reporter = reporter
    @seen = seen
  end

  def strip_comments_and_blanks(source)
    header, body = split_header(source)
    candidate = header + body.lines.reject { |l| l.strip.empty? || l.strip.start_with?("#") }.join
    return source if candidate == source
    return source unless @seen.novel?(candidate) && ruby_syntax_valid?(candidate) && @oracle.reproduces?(candidate)

    @budget.accept!
    @reporter.accepted("strip", "comments+blanks", source, candidate)
    candidate
  end
end

# One candidate edit: replace source[start...finish] with `replacement`.
Candidate = Struct.new(:start, :finish, :replacement, :label)

# Stage 2: delta debugging over a Prism parse tree. Every pass re-parses
# and re-collects the full candidate list (biggest span first), tests
# `--jobs` at a time concurrently via threads, and applies the first one
# that still reproduces the bug.
class AstReducer
  def initialize(oracle:, budget:, reporter:, seen:, jobs:)
    @oracle = oracle
    @budget = budget
    @reporter = reporter
    @seen = seen
    @jobs = jobs
  end

  def reduce(source)
    loop do
      return source if @budget.exhausted?

      pair = find_passing(source, collect_candidates(source))
      return source unless pair

      label, reduced = pair
      @budget.accept!
      @reporter.accepted("reduce", label, source, reduced)
      source = reduced
      yield source if block_given?
    end
  end

  private

  def collect_candidates(source)
    result = Prism.parse(source)
    return [] unless result.success?

    calls_by_name = bare_calls_by_name(result.value)

    candidates = []
    stack = [result.value]
    until stack.empty?
      node = stack.pop
      stack.concat(node.compact_child_nodes)
      candidates.concat(candidates_for(node, source, calls_by_name))
    end
    candidates.sort_by { |c| -priority(c) }
  end

  # A plain deletion (alias_method call, unused wrapper method, a
  # validation "raise ... if/unless ..." line, a dead rescue clause) or an
  # inline substitution is a much safer bet than a placeholder/stub
  # substitution of similar size - it removes or collapses a whole
  # self-contained unit instead of hoping some literal happens to
  # type-check in its place. A flat bonus (not a multiplier - see the
  # reverted coverage-boost experiment for why a multiplier caused
  # trouble) surfaces these ahead of the much larger pile of speculative
  # stub candidates without ever letting a small one outrank an
  # actually-bigger class/module deletion.
  QUICK_WIN_BONUS = 200

  def priority(candidate)
    size = candidate.finish - candidate.start
    quick_win = candidate.replacement.empty? || candidate.label.start_with?("inline")
    quick_win ? size + QUICK_WIN_BONUS : size
  end

  def candidates_for(node, source, calls_by_name)
    case node
    when Prism::DefNode
      method_candidates(node) + node_candidates(node, "def #{node.name}") + inline_candidates(node, source, calls_by_name)
    when Prism::StatementsNode
      body_candidates(node) + statement_candidates(node)
    when Prism::CallNode
      attr_candidates(node)
    when *TARGET_NODE_CLASSES
      node_candidates(node, node.class.name.split("::").last)
    else
      []
    end
  end

  ATTR_METHOD_NAMES = %w[attr_accessor attr_reader attr_writer].freeze

  # `attr_accessor :a, :b, :c` only gets tried as a whole-statement
  # deletion via statement_candidates, which only fires if *none* of a, b,
  # c are used - if just one of several is still needed, the whole call
  # never goes away. Offer removing one symbol (plus its neighboring
  # comma) at a time instead, so unused ivars can drop out individually.
  def attr_candidates(node)
    return [] unless node.receiver.nil? && ATTR_METHOD_NAMES.include?(node.name.to_s)

    args = node.arguments&.arguments || []
    return [] if args.length <= 1

    args.each_index.filter_map do |i|
      next unless args[i].is_a?(Prism::SymbolNode)

      if i < args.length - 1
        start = args[i].location.start_offset
        finish = args[i + 1].location.start_offset
      else
        start = args[i - 1].location.end_offset
        finish = args[i].location.end_offset
      end

      Candidate.new(start, finish, "", "delete #{node.name} #{args[i].slice}")
    end
  end

  # Bare (no-receiver) calls, grouped by method name - used to find
  # methods with exactly one call site, which are safe to inline: a
  # receiver-less call within the file almost always resolves to a method
  # defined in the same class, unlike `obj.foo` where we'd have no idea
  # which class's `foo` is meant without real type info.
  def bare_calls_by_name(root)
    calls = Hash.new { |h, k| h[k] = [] }
    stack = [root]
    until stack.empty?
      n = stack.pop
      stack.concat(n.compact_child_nodes)
      calls[n.name] << n if n.is_a?(Prism::CallNode) && n.receiver.nil?
    end
    calls
  end

  # If this method has exactly one bare call site anywhere in the file and
  # only simple required positional parameters (no optional/keyword/splat/
  # block - those are harder to substitute correctly and rare in the
  # small wrapper methods this is meant to catch), offer to replace that
  # one call with the method's own body, params substituted for the call's
  # arguments. The now-orphaned `def` gets cleaned up by the existing
  # whole-method deletion candidate on a later pass - no need to do that
  # here too.
  def inline_candidates(node, source, calls_by_name)
    return [] unless node.body
    return [] unless simple_positional_params?(node)

    calls = calls_by_name[node.name]
    return [] unless calls && calls.length == 1

    call = calls.first
    params = node.parameters&.requireds || []
    args = call.arguments&.arguments || []
    return [] unless params.length == args.length

    body_loc = node.body.location
    body_text = "(begin\n#{source[body_loc.start_offset...body_loc.end_offset]}\nend)"
    substituted = substitute_params(body_text, params, args, source)

    [Candidate.new(call.location.start_offset, call.location.end_offset, substituted, "inline #{node.name}")]
  end

  def simple_positional_params?(node)
    params = node.parameters
    return true unless params

    params.optionals.empty? && params.rest.nil? && params.posts.empty? &&
      params.keywords.empty? && params.keyword_rest.nil? && params.block.nil?
  end

  # Single simultaneous substitution pass (not one gsub per parameter) so
  # substituting param A's argument text can never accidentally introduce
  # a new occurrence of param B's name that then gets substituted again.
  def substitute_params(body_text, params, args, source)
    replacements = params.zip(args).to_h do |param, arg|
      arg_text = source[arg.location.start_offset...arg.location.end_offset]
      [param.name.to_s, "(#{arg_text})"]
    end
    return body_text if replacements.empty?

    pattern = /\b(#{replacements.keys.map { Regexp.escape(_1) }.join("|")})\b/
    body_text.gsub(pattern) { replacements.fetch(_1) }
  end

  def node_candidates(node, label)
    loc = node.location
    return [] if loc.start_offset == loc.end_offset

    [
      Candidate.new(loc.start_offset, loc.end_offset, "", "delete #{label}"),
      Candidate.new(loc.start_offset, loc.end_offset, "nil", "stub #{label}"),
    ]
  end

  # A method's body, offered every generic placeholder plus each of the
  # method's own parameter names as a passthrough stub: `def tokenize(v) =
  # v` is a common enough shape that a blind delete/placeholder search may
  # never stumble onto it.
  def method_candidates(node)
    return [] unless node.body

    loc = node.body.location
    return [] if loc.start_offset == loc.end_offset

    (PLACEHOLDERS + parameter_names(node)).map do |replacement|
      Candidate.new(loc.start_offset, loc.end_offset, replacement, "def #{node.name} body -> #{replacement}")
    end
  end

  def parameter_names(node)
    return [] unless node.parameters

    node.parameters.compact_child_nodes.filter_map do |param|
      name = param.name if param.respond_to?(:name)
      name&.to_s
    end
  end

  def body_candidates(node)
    return [] if node.location.start_offset.zero? # never nuke the whole program in one shot

    loc = node.location
    [
      Candidate.new(loc.start_offset, loc.end_offset, "", "delete body"),
      Candidate.new(loc.start_offset, loc.end_offset, "nil", "stub body"),
    ]
  end

  def statement_candidates(node)
    node.body.filter_map do |stmt|
      loc = stmt.location
      next if loc.start_offset == loc.end_offset

      Candidate.new(loc.start_offset, loc.end_offset, "", "delete #{stmt.class.name.split("::").last}")
    end
  end

  def splice(source, candidate)
    "#{source[0...candidate.start]}#{candidate.replacement}#{source[candidate.finish..]}"
  end

  # Test up to `--jobs` candidates at a time: cheap in-process filtering
  # (dedup + syntax check) happens sequentially first, then only the
  # survivors pay for a real ruby+spinel round-trip, in parallel threads.
  # Returns [label, reduced_source] for the first (highest-priority, since
  # the list is biggest-first) candidate that reproduces, or nil.
  def find_passing(source, candidates)
    candidates.each_slice(@jobs) do |slice|
      return nil if @budget.exhausted?

      prepared = slice.filter_map do |c|
        reduced = splice(source, c)
        next nil if reduced == source
        next nil unless @seen.novel?(reduced) && ruby_syntax_valid?(reduced)

        [c.label, reduced]
      end
      @reporter.tried(slice.length)
      next if prepared.empty?

      oks = prepared.map { |_, reduced| Thread.new(reduced) { |src| @oracle.reproduces?(src) } }.map(&:value)
      winner = prepared.zip(oks).find { |_, ok| ok }
      return winner.first if winner
    end
    nil
  end
end

# A bare `raise if/unless cond` (no message) is the common shape in this
# repo's spinel_N.rb repros, but it makes the oracle weak: any candidate
# that fails for a *different* underlying reason still prints the same
# generic "RuntimeError (RuntimeError)" text, so the marker-based check in
# Oracle#calibrate! can't tell the two apart. If the source already has a
# quoted message on some raise, there's nothing to suggest. Otherwise, find
# the first bare `raise if/unless` and propose inserting a message.
BARE_RAISE_RE = /\A([ \t]*)raise\s+(if|unless)\s+(.+?)\s*\z/

def weak_raise_suggestion(source)
  return nil if source.match?(/raise\s+"[^"]*"/)

  source.each_line.with_index(1) do |line, lineno|
    next unless (m = BARE_RAISE_RE.match(line.chomp))

    indent, keyword, cond = m.captures
    return {
      lineno:,
      original: line.chomp,
      fixed: "#{indent}raise \"REDUCE_MARKER\" #{keyword} #{cond}",
    }
  end
  nil
end

# Finds the anchor line to suggest putting `# reduce:freeze` above, when
# no freeze marker is present at all. Looks for a `raise "..."` line
# (message quoted or not, modifier or not) - the same shape the marker
# regex elsewhere in this file expects.
def missing_freeze_suggestion(source)
  return nil if FREEZE_MARKER_RE.match?(source)

  m = /^([ \t]*)(raise\s+"[^"]*".*)$/.match(source)
  return nil unless m

  {lineno: source[0...m.begin(0)].count("\n") + 1, indent: m[1], line: m[2]}
end

# Runs rubocop with the given args against `source` and returns the
# resulting text (or `source` unchanged if rubocop errors out).
def rubocop_autocorrect(source, path, args)
  File.write(path, source)
  run_with_timeout(["bundle", "exec", "rubocop", "--config", ROOT_RUBOCOP_CONFIG, *args, path], RUBOCOP_TIMEOUT)
  File.read(path)
rescue
  source
end

# REDUCE.md warns that full autocorrect may change the bug shape, but the
# oracle is the actual source of truth here: try the strongest cleanup
# first (`-A`, every cop including unsafe ones) and keep it only if it
# still reproduces. Fall back to a narrow, layout-only pass if `-A` broke
# the repro, and give up on cleanup entirely (keep the pre-cleanup source)
# if even that fails.
def rubocop_cleanup(source, oracle, path, reporter)
  full = rubocop_autocorrect(source, path, ["-A"])
  if full != source && ruby_syntax_valid?(full) && oracle.reproduces?(full)
    reporter.line "rubocop -A applied"
    return full
  end

  narrow = rubocop_autocorrect(source, path, ["-a", "--only", "Layout,Style/TrailingWhitespace,Style/EmptyLines"])
  if narrow != source && ruby_syntax_valid?(narrow) && oracle.reproduces?(narrow)
    reporter.line((full == source) ? "rubocop -A made no change" : "rubocop -A broke the repro; fell back to narrow Layout-only cleanup")
    return narrow
  end

  reporter.line "rubocop cleanup skipped (no change or broke the repro)"
  source
end

def main
  default_jobs = [Etc.nprocessors - 1, 1].max
  options = {output: nil, spinel: ENV["SPINEL"] || "spinel", jobs: default_jobs,
             limit: nil, max_attempts: nil, max_minutes: nil, quiet: false,}
  OptionParser.new do |opts|
    opts.banner = "Usage: bin/reduce_claude [options] input.rb"
    opts.on("-o PATH", "--output PATH", "Where to write the reduced source (default: input_r.rb)") { options[:output] = _1 }
    opts.on("-j N", "--jobs N", Integer, "Parallel candidate checks (default: nproc-1 = #{default_jobs})") { options[:jobs] = _1 }
    opts.on("--limit N", Integer, "Stop after N accepted reductions") { options[:limit] = _1 }
    opts.on("--max-attempts N", Integer, "Stop after N candidates tried (accepted + rejected)") { options[:max_attempts] = _1 }
    opts.on("--max-minutes N", Float, "Stop after N minutes wall-clock") { options[:max_minutes] = _1 }
    opts.on("--spinel PATH", "Path to the spinel binary (default: spinel)") { options[:spinel] = _1 }
    opts.on("-q", "--quiet", "Suppress progress output") { options[:quiet] = true }
    opts.on("--allow-weak-oracle", "Reduce anyway when the raise has no message (matches on exit code only)") { options[:allow_weak_oracle] = true }
    opts.on("--allow-unfrozen-tail", "Reduce anyway with no # reduce:freeze marker protecting the assertion") { options[:allow_unfrozen_tail] = true }
  end.parse!(ARGV)

  input = ARGV.first
  abort "usage: bin/reduce_claude [options] input.rb" unless input
  output = options[:output] || "#{input.sub(/\.rb\z/, "")}_r.rb"

  source = File.read(input)
  abort "input is not ASCII-only; byte-offset splicing assumes ASCII" unless source.ascii_only?

  warn "input: #{input}, #{source.bytesize}b (#{humanize_bytes(source.bytesize)}), #{source.lines.length} lines"

  if (weak = weak_raise_suggestion(source)) && !options[:allow_weak_oracle]
    abort <<~MSG
      weak oracle: line #{weak[:lineno]} raises with no message, so a reduced
      candidate could fail for a different underlying reason and still look
      like the same bug. Add a specific message and re-run:

        - #{weak[:original]}
        + #{weak[:fixed]}

      (pass --allow-weak-oracle to reduce anyway, matching on exit code only)
    MSG
  end

  if (anchor = missing_freeze_suggestion(source)) && !options[:allow_unfrozen_tail]
    abort <<~MSG
      no freeze marker: nothing structurally protects line #{anchor[:lineno]}
      (the assertion driving this repro) from being modified by the reducer.
      Add a `# reduce:freeze` comment directly above it and re-run:

      + #{anchor[:indent]}# reduce:freeze (do not modify anything below this line)
        #{anchor[:indent]}#{anchor[:line]}

      (pass --allow-unfrozen-tail to reduce anyway without this protection)
    MSG
  elsif !FREEZE_MARKER_RE.match?(source)
    # No raise line at all is expected for a compile-time-only bug (Spinel
    # fails/warns during compilation itself; there's no runtime assertion
    # to protect and nothing meaningful to freeze). Warn, don't block.
    warn "no freeze marker and no `raise \"...\"` line found; proceeding " \
      "unprotected (expected for a compile-time-only repro)"
  end

  frozen_head, tail = split_frozen_tail(source)
  header, head = split_header(frozen_head)
  warn "frozen header: #{header.bytesize}b (never parsed, offered, or cleaned up)" unless header.empty?
  warn "frozen tail: #{tail.bytesize}b (never parsed, offered, or cleaned up); reducible head: #{head.bytesize}b" unless tail.empty?

  oracle = Oracle.new(spinel_bin: options[:spinel], prefix: header, tail:)
  oracle.calibrate!(head)
  warn "running with #{options[:jobs]} parallel jobs"

  budget = Budget.new(limit: options[:limit], max_attempts: options[:max_attempts], max_minutes: options[:max_minutes])
  reporter = Reporter.new(budget:, quiet: options[:quiet])
  seen = SeenSet.new
  seen.novel?(head)

  checkpoint = ->(partial_head) { File.write(output, header + partial_head + tail) }

  line_reducer = LineReducer.new(oracle:, budget:, reporter:, seen:)
  head = line_reducer.strip_comments_and_blanks(head)
  checkpoint.call(head)

  unless budget.exhausted?
    ast_reducer = AstReducer.new(oracle:, budget:, reporter:, seen:, jobs: options[:jobs])
    head = ast_reducer.reduce(head, &checkpoint)
  end

  reason = budget.exhausted? ? budget.stop_reason : "full pass with no accepted reduction"
  reporter.line "stopped: #{reason} (#{budget.accepted} accepted reductions, #{budget.elapsed.round(1)}s)"

  head = rubocop_cleanup(head, oracle, output, reporter)

  source = header + head + tail
  File.write(output, source)
  warn "done: #{source.bytesize}b (#{humanize_bytes(source.bytesize)}), #{source.lines.length} lines, written to #{output}"
end

main if __FILE__ == $PROGRAM_NAME
