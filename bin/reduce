#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: MAX=minutes bin/reduce file.rb (MAX defaults to 2)" >&2
  exit 1
fi

MAX=${MAX:-1}
JOBS=${JOBS:-2}

input=$1
if [[ ! -f "$input" ]]; then
  echo "bin/reduce: no such file: $input" >&2
  exit 1
fi
input=$(cd "$(dirname "$input")" && pwd)/$(basename "$input")

dir=$(cd "$(dirname "$input")" && pwd)
base=$(basename "$input")
name=${base%.rb}
output="$dir/${name}_reduce.rb"
workdir="build/reduce"

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$script_dir/.." && pwd)
cd "$root"

rm -rf "$workdir"
mkdir -p "$workdir"

current="$workdir/input.rb"
cp "$input" "$current"

run_pass() {
  local tool=$1
  local pass=$2
  local next="$workdir/pass_${pass}.rb"

  echo "==> $tool pass $pass: $current -> $next" >&2
  "bin/reduce_$tool" --max-minutes "$MAX" -j "$JOBS" -o "$next" "$current"
  echo
  current="$next"
}

run_pass claude 1
run_pass codex 2
run_pass claude 3
run_pass codex 4

cp "$current" "$workdir/output.rb"
cp "$current" "$output"
echo "==> kept artifacts in $workdir" >&2
echo "==> wrote $output" >&2
