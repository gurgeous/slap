#!/usr/bin/env ruby

#
# Reduce a Ruby file into a smaller Spinel repro. Keep the public CLI small;
# most reduction strategy is just sensible defaults.
#

require "digest"
require "etc"
require "fileutils"
require "open3"
require "optparse"
require "prism"
require "tempfile"
require "time"
require "tmpdir"

# Open3 reader threads can report a benign closed-stream error while Ctrl-C
# unwinds a candidate check. Joining those threads still raises real failures.
Thread.report_on_exception = false

# A hard structural boundary for the assertion driving the repro,
# independent of (and stronger than) reasoning about which candidate
# types could theoretically reach it: put `# keep` on its own
# comment line right before the raise/marker line, and everything from
# that line to EOF is split off as `tail` and never parsed or offered as a
# candidate - it's carried through untouched during reduction.
KEEP_MARKER_RE = /#\s*keep\b/
TAIL_KEEP_MARKER_RE = /^[ \t]*#(?:\s*keep\b|.*reduce:freeze\b).*$/

# Splits source into [head, tail] at the standalone keep marker (tail includes
# marker line itself). No marker present -> [source, ""].
def split_protected_tail(source)
  match = TAIL_KEEP_MARKER_RE.match(source)
  return [source, ""] unless match

  [source[0...match.begin(0)], source[match.begin(0)..]]
end

# Byte ranges for source lines that an inline `# keep` marker protects.
def keep_line_ranges(source)
  offset = 0
  source.each_line.filter_map do |line|
    range = offset...(offset + line.bytesize)
    offset += line.bytesize
    range if KEEP_MARKER_RE.match?(line)
  end
end

def touches_keep?(candidate, keep_ranges)
  keep_ranges.any? { |range| candidate.start < range.end && candidate.finish > range.begin }
end

def split_header(source)
  lines = source.lines
  idx = 0
  idx += 1 while idx < lines.length && (lines[idx].strip.empty? || lines[idx].strip.start_with?("#"))
  [lines[0...idx].join, lines[idx..].join]
end

Candidate = Struct.new(:start, :finish, :replacement, :label) do
  def gain = size - replacement.bytesize
  def size = finish - start
  def noteworthy? = label.end_with?(" AST")
end

class InterruptState
  def initialize
    @interrupted = false
    %w[INT TERM].each do |signal|
      Signal.trap(signal) do
        @interrupted = true
        raise Interrupt
      end
    end
  end

  def interrupted? = @interrupted
end

class Budget
  attr_reader :accepted, :max_minutes, :started_at, :tests

  def initialize(max_minutes, interrupt_state)
    @accepted = 0
    @interrupt_state = interrupt_state
    @max_minutes = max_minutes
    @started_at = Time.now
    @tests = 0
  end

  def accept! = @accepted += 1
  def test! = @tests += 1

  def exhausted?
    interrupted? || expired?
  end

  def stop_reason
    return "interrupted" if interrupted?
    return "max-minutes #{max_minutes}" if expired?

    "no gains"
  end

  def cleanup_allowed? = !interrupted?
  def interrupted? = @interrupt_state.interrupted?
  def elapsed = "#{(Time.now - started_at).round(1)}s"
  def expired? = max_minutes && (Time.now - started_at) >= max_minutes * 60
end

class Reporter
  attr_reader :budget

  def initialize(budget)
    @budget = budget
  end

  def start(input, source, failure, jobs)
    line "jobs=#{jobs}, max-minutes=#{budget.max_minutes}"
    line "event     n    label                                 kb    delta    tests     time  saved"
    line row("start", "-", input, source, 0, 0, saved: true)
    line "failure: #{failure.label}"
  end

  def accept(label, before, after)
    line row("accept", budget.accepted, label, after, after.bytesize - before.bytesize, budget.tests, saved: true)
  end

  def cleanup_start
    line "rubocop -A: running"
  end

  def cleanup(status, before, after)
    line row("cleanup", "-", "rubocop -A #{status}", after, after.bytesize - before.bytesize, budget.tests, saved: true)
  end

  def reject(candidate, before, after, reason)
    return unless candidate.noteworthy?

    line row("reject", "-", "#{candidate.label}: #{reason}", after, after.bytesize - before.bytesize, budget.tests)
  end

  def stop(output)
    line "stop: #{budget.stop_reason}, kept=#{output}, tried=#{budget.tests}, accepted=#{budget.accepted}, elapsed=#{budget.elapsed}"
  end

  def line(message)
    warn message
  end

  def row(event, n, label, source, delta, tests, saved: false)
    bytes = source.respond_to?(:bytesize) ? source.bytesize : nil
    format(
      "%-9s %-4s %-34s %8s %+8d %8s %8s  %s",
      event,
      n,
      label.to_s[0, 34],
      human_bytes(bytes),
      delta,
      tests,
      budget.elapsed,
      saved ? "yes" : ""
    )
  end

  def human_bytes(bytes)
    return "-" unless bytes

    "#{format("%.1f", bytes / 1000.0)}k"
  end
end

class Failure
  attr_reader :kind, :marker, :output

  def initialize(kind, output, marker)
    @kind = kind
    @marker = marker
    @output = output
  end

  def label = "#{kind} #{marker}"
end

class Oracle
  attr_reader :prefix, :source_marker

# head/tail: see split_protected_tail. tail is appended internally before
  # every ruby/spinel run so callers only ever deal with the reducible
  # head.
  def initialize(head, prefix: "", tail: "")
    @prefix = prefix
    @tail = tail
    @source_marker = (prefix + head + tail)[/raise\s+"([^"]+)"/, 1]
  end

  def baseline(head)
    source = prefix + head + @tail
    fail "input does not pass ruby" unless ruby_ok?(source)

    failure = spinel_failure(source)
    fail "input does not fail under spinel" unless failure

    if failure.kind == :runtime && failure.marker == source_marker && !failure.output.include?(source_marker)
      fail "marker #{source_marker.inspect} not found in spinel failure"
    end

    failure
  end

  def candidate?(head, baseline)
    candidate_source?(prefix + head + @tail, baseline)
  end

  def candidate_source?(source, baseline)
    !rejection_reason_for(source, baseline)
  end

  def rejection_reason(head, baseline)
    rejection_reason_for(prefix + head + @tail, baseline)
  end

  def rejection_reason_for(source, baseline)
    return "ruby failed" unless ruby_ok?(source)

    current = spinel_failure(source)
    return "spinel passed" unless current
    return "spinel #{current.kind}" unless current.kind == baseline.kind
    if baseline.kind == :runtime && baseline.marker == source_marker &&
        current.kind == :runtime && !current.output.include?(source_marker)
      return "marker missing"
    end
    return "marker changed" unless current.marker == baseline.marker

    nil
  end

  protected

  def ruby_ok?(source)
    with_source(source) do |path|
      system("ruby", path, out: File::NULL, err: File::NULL)
    end
  end

  def spinel_failure(source)
    with_source(source) do |path|
      Dir.mktmpdir("reduce-codex") do |dir|
        out = File.join(dir, "out")
        compile_out, compile_err, compile_status = Open3.capture3("spinel", "-o", out, path)
        unless compile_status.success?
          output = "#{compile_out}#{compile_err}"
          return Failure.new(:compile, output, diagnostic_marker(output))
        end

        # AGENTS.md: an unexpected spinel warning is itself the bug, even if
        # compilation and the run both otherwise succeed - never let a
        # candidate "still reproduce" by dropping the warning while the
        # binary happens to run fine. spinel also prints "input -> output"
        # to stderr on every successful compile regardless of any bug -
        # strip that routine notice first so it's never mistaken for one.
        compile_warning = strip_routine_notice("#{compile_out}#{compile_err}", path, out).strip
        return Failure.new(:warning, compile_warning, diagnostic_marker(compile_warning)) unless compile_warning.empty?

        run_out, run_err, run_status = Open3.capture3(out)
        return nil if run_status.success?

        output = "#{run_out}#{run_err}"
        marker = (source_marker && output.include?(source_marker)) ? source_marker : runtime_marker(output)
        Failure.new(:runtime, output, marker)
      end
    end
  end

  def strip_routine_notice(text, input_path, output_path)
    notice = "#{input_path} -> #{output_path}"
    text.lines.reject { |l| l.strip == notice }.join
  end

  def runtime_marker(output)
    line = output.lines.find { _1.include?("RuntimeError") }
    line ? line.strip : first_line(output)
  end

  # Keep compiler failure identity stable as candidates change line numbers and
  # temporary paths. Include the generated function plus normalized compiler
  # error/warning/note lines, so reductions preserve details such as expected
  # and actual C types instead of matching only the first broad diagnostic.
  def diagnostic_marker(output)
    lines = output.lines.map(&:strip).reject(&:empty?)
    function = lines.find { _1.include?("In function") }
    function = function.sub(/\A.*?: In function /, "function ") if function

    diagnostics = lines.filter_map { normalized_diagnostic(_1) }
    diagnostics << normalized_spinel_line(lines) if diagnostics.empty?
    [function, *diagnostics].compact.join(" | ").gsub(/node \d+/, "node N")
  end

  def normalized_diagnostic(line)
    return unless (match = /\b(fatal error|error|warning|note):\s*(.*)\z/.match(line))

    "#{match[1]}: #{match[2]}"
  end

  def normalized_spinel_line(lines)
    line = lines.find { _1.start_with?("spinel:") } || lines.first.to_s
    line.sub(/\Aspinel:\s+\S+:\d+:\s*/, "spinel: ")
  end

  def first_line(output)
    output.lines.find { !_1.strip.empty? }.to_s.strip
  end

  def with_source(source)
    Tempfile.create(["reduce-codex", ".rb"]) do |file|
      file.write(source)
      file.close
      yield file.path
    end
  end
end

class Reducer
  SKIP_NODES = %w[ProgramNode StatementsNode]
  STUBS = ["nil", "false", "true", "\"\"", "[]", "{}", "0", "1", ":x", "self"]

  attr_reader :budget, :failed, :failure, :jobs, :oracle, :output, :prefix, :reporter, :seen, :tail

  # prefix/tail are frozen source around the reducible body. Every write
  # reattaches them so artifacts stay readable and runnable.
  def initialize(oracle:, failure:, output:, jobs:, budget:, reporter:, prefix: "", tail: "")
    @budget = budget
    @failed = {}
    @failure = failure
    @jobs = jobs
    @oracle = oracle
    @output = output
    @prefix = prefix
    @reporter = reporter
    @seen = {}
    @tail = tail
  end

  def run(source)
    File.write(output, prefix + source + tail)
    source = run_phase(source, "comments") { |current| [comment_candidate(current)] }
    source = run_phase(source, "ast") { |current| ast_candidates(current, min_gain: 80) }
    source = run_phase(source, "ast") { |current| ast_candidates(current, min_gain: 80) }
    source = run_phase(source, "ast") { |current| ast_candidates(current, min_gain: 1) }
    source = run_phase(source, "lines") { |current| line_candidates(current) }
    source
  rescue Interrupt
    source
  end

  protected

  # IMPORTANT: always call `yield(source)` here, passing this method's own
  # current `source` explicitly - never bare `yield`. A bare `yield` would
  # re-invoke the caller's block using whatever variable *it* closed over,
  # which is a different, never-updated variable of the same name in
  # `run` - candidates would keep being generated against the pre-loop
  # text while actually being spliced into the already-edited text,
  # silently corrupting the file a few bytes off on the second+ accept
  # within a single run_phase call.
  def run_phase(source, phase)
    loop do
      return source if budget.exhausted?

      result = find_passing(source, yield(source).compact)
      return source unless result

      candidate, reduced = result
      before = source
      source = reduced
      File.write(output, prefix + source + tail)
      budget.accept!
      reporter.accept("#{phase}: #{candidate.label}", before, source)
    end
  end

  def find_passing(source, candidates)
    candidates.each_slice(jobs) do |slice|
      results = slice.map do |candidate|
        Thread.new(candidate) { |thread_candidate| test_candidate(source, thread_candidate) }
      end.map(&:value)
      accepted = results.compact.first
      return accepted if accepted

    end
    nil
  end

  def test_candidate(source, candidate)
    signature = candidate_signature(source, candidate)
    return if failed[signature]

    reduced = replace(source, candidate)
    return if reduced == source
    return unless reduced.bytesize < source.bytesize
    return unless syntax_ok?(reduced)
    return unless novel?(reduced)

    budget.test!
    if (reason = oracle.rejection_reason(reduced, failure))
      failed[signature] = true
      reporter.reject(candidate, source, reduced, reason)
      return
    end

    [candidate, reduced]
  end

  def comment_candidate(source)
    header, body = split_header(source)
    stripped = header + body.lines.reject { comment_line?(_1) && !KEEP_MARKER_RE.match?(_1) }.join
    return if stripped == source

    Candidate.new(0, source.bytesize, stripped, "comments+blanks")
  end

  def line_candidates(source)
    lines = source.lines
    offsets = line_offsets(lines)
    sizes = (0..).lazy.map { 2**_1 }.take_while { _1 < lines.count }.to_a.reverse

    keep_ranges = keep_line_ranges(source)
    sizes.flat_map do |line_count|
      (0...lines.count).step(line_count).map do |start|
        finish = [start + line_count, lines.count].min
        Candidate.new(offsets[start], offsets[finish], "", "lines #{start + 1}-#{finish}")
      end
    end.reject { touches_keep?(_1, keep_ranges) }
  end

  def ast_candidates(source, min_gain:)
    result = Prism.parse(source)
    return [] unless result.success?

    collect(result.value, source).select { _1.gain >= min_gain }
  end

  def collect(root, source)
    groups = []
    stack = [root]
    until stack.empty?
      node = stack.pop
      stack.concat(node.compact_child_nodes)
      candidates = (statement_candidates(node) + Array(candidate_for(node, source))).compact.sort_by { [-_1.gain, -_1.size] }
      groups << [node_size(node), candidates.compact] unless candidates.empty?
    end
    keep_ranges = keep_line_ranges(source)
    groups.sort_by { -_1.first }.flat_map(&:last).reject { touches_keep?(_1, keep_ranges) }
  end

  def candidate_for(node, source)
    candidates = []
    candidates.concat(method_candidates(node)) if node.is_a?(Prism::DefNode)
    candidates.concat(body_candidates(node)) if node.is_a?(Prism::StatementsNode)
    if reducible_node?(node)
      candidates.concat(node_candidates(node))
      candidates.concat(hoist_candidates(node, source))
    end
    candidates
  end

  def method_candidates(node)
    return [] unless node.body

    [candidate(node, "", "delete def #{node.name}")] +
      (STUBS + parameter_names(node)).map { candidate(node.body, _1, "def #{node.name} body -> #{_1}") }
  end

  def parameter_names(node)
    return [] unless node.parameters

    node.parameters.child_nodes.filter_map do |param|
      next unless param.respond_to?(:name)

      param.name&.to_s
    end
  end

  def statement_candidates(node)
    return [] unless node.is_a?(Prism::StatementsNode)

    node.body.map { candidate(_1, "", "#{_1.class.name.split("::").last}-statement") }
  end

  def body_candidates(node)
    return [] if node.location.start_offset.zero?

    [
      candidate(node, "", "body-delete"),
      candidate(node, "nil", "body"),
    ]
  end

  def node_candidates(node)
    label = node.class.name.split("::").last
    [candidate(node, "", "#{label}-delete")] +
      STUBS.map { candidate(node, _1, "#{label} -> #{_1}") }
  end

  def hoist_candidates(node, source)
    label = node.class.name.split("::").last
    children = node.compact_child_nodes.sort_by { -node_size(_1) }
    children.map do |child|
      candidate(node, source[child.location.start_offset...child.location.end_offset], "#{label}->child")
    end
  end

  def node_size(node)
    node.location.end_offset - node.location.start_offset
  end

  def reducible_node?(node)
    label = node.class.name.split("::").last
    !SKIP_NODES.include?(label) && node.respond_to?(:location) && node_size(node).positive?
  end

  def candidate(node, replacement, label)
    location = node.location
    return if location.start_offset == location.end_offset

    Candidate.new(location.start_offset, location.end_offset, replacement, label)
  end

  def novel?(source)
    digest = Digest::SHA256.hexdigest(source)
    return false if seen[digest]

    seen[digest] = true
  end

  def replace(source, candidate)
    "#{source[0...candidate.start]}#{candidate.replacement}#{source[candidate.finish..]}"
  end

  def syntax_ok?(source)
    Prism.parse(source).success?
  end

  def line_offsets(lines)
    offsets = [0]
    lines.each { offsets << offsets.last + _1.bytesize }
    offsets
  end

  def candidate_signature(source, candidate)
    original = source[candidate.start...candidate.finish].to_s
    "#{candidate.label}:#{original}:#{candidate.replacement}"
  end

  # one-liners
  def comment_line?(line) = line.strip.empty? || line.strip.start_with?("#")
end

BARE_RAISE_RE = /\A([ \t]*)raise\s+(if|unless)\s+(.+?)\s*\z/

def weak_raise_warning(source)
  return if source.match?(/raise\s+"[^"]*"/)

  source.each_line.with_index(1) do |line, lineno|
    next unless (match = BARE_RAISE_RE.match(line.chomp))

    indent, keyword, condition = match.captures
    warn "warning: weak oracle on line #{lineno}; consider:"
    warn "#{indent}raise \"REDUCE_MARKER\" #{keyword} #{condition}"
    return
  end
end

# Finds the anchor line to suggest putting `# keep` above, when
# no standalone keep marker is present at all. Looks for a `raise "..."` line
# (message quoted or not, modifier or not) - the same shape the marker
# regex elsewhere in this file expects.
def missing_keep_suggestion(source)
  return nil if TAIL_KEEP_MARKER_RE.match?(source)

  m = /^([ \t]*)(raise\s+"[^"]*".*)$/.match(source)
  return nil unless m

  {lineno: source[0...m.begin(0)].count("\n") + 1, indent: m[1], line: m[2]}
end

# Format the complete artifact only after reduction, retaining it only when
# the original failure still reproduces.
def cleanup(source, output, oracle, failure, reporter)
  reporter.cleanup_start
  File.write(output, source)
  unless system("bundle", "exec", "rubocop", "-A", output, out: File::NULL, err: File::NULL)
    reporter.cleanup("failed", source, source)
    return source
  end

  cleaned = File.read(output)
  if cleaned == source
    reporter.cleanup("unchanged", source, source)
    return source
  end

  if oracle.candidate_source?(cleaned, failure)
    reporter.cleanup("accepted", source, cleaned)
    return cleaned
  end

  File.write(output, source)
  reporter.cleanup("rejected", source, source)
  source
end

options = {
  jobs: Etc.respond_to?(:nprocessors) ? [Etc.nprocessors - 1, 1].max : 1,
  max_minutes: 1,
  output: nil,
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/reduce [options] input.rb"
  opts.on("-o", "--output PATH", "Write reduced source here (default: input_reduce.rb)") { options[:output] = _1 }
  opts.on("-j", "--jobs N", Integer, "Test N candidates in parallel (default: nproc-1)") { options[:jobs] = _1 }
  opts.on("--max-minutes N", Float, "Stop after N minutes (default: 1)") { options[:max_minutes] = _1 }
  opts.on("--allow-unkept-tail", "--allow-unfrozen-tail", "Reduce anyway with no standalone # keep marker protecting the assertion") { options[:allow_unkept_tail] = true }
end

parser.parse!
input = ARGV.shift
abort parser.to_s unless input

interrupt_state = InterruptState.new
output = options[:output] || input.sub(/\.rb\z/, "_reduce.rb")
source_path = File.exist?(output) ? output : input
source = File.read(source_path)
FileUtils.mkdir_p(File.dirname(output))
result = source

begin
  weak_raise_warning(source)

  if (anchor = missing_keep_suggestion(source)) && !options[:allow_unkept_tail]
    abort <<~MSG
      no standalone # keep marker: nothing structurally protects line #{anchor[:lineno]}
      (the assertion driving this repro) from being modified by the reducer.
      Add a `# keep` comment directly above it and re-run:

        + #{anchor[:indent]}# keep (do not modify anything below this line)
        #{anchor[:indent]}#{anchor[:line]}

      (pass --allow-unkept-tail to reduce anyway without this protection)
    MSG
  elsif !TAIL_KEEP_MARKER_RE.match?(source)
    # No raise line at all is expected for a compile-time-only bug (Spinel
    # fails/warns during compilation itself; there's no runtime assertion
    # to protect and nothing meaningful to freeze). Warn, don't block.
    warn "no standalone # keep marker and no `raise \"...\"` line found; proceeding " \
      "unprotected (expected for a compile-time-only repro)"
  end

  protected_head, tail = split_protected_tail(source)
  header, head = split_header(protected_head)

  budget = Budget.new(options[:max_minutes], interrupt_state)
  reporter = Reporter.new(budget)
  oracle = Oracle.new(head, prefix: header, tail:)
  failure = oracle.baseline(head)
  reporter.start(source_path, head, failure, options[:jobs])
  reporter.line("protected header: #{header.bytesize}b (never parsed or offered)") unless header.empty?
  reporter.line("protected tail: #{tail.bytesize}b (never parsed or offered)") unless tail.empty?

  reducer = Reducer.new(
    oracle:,
    failure:,
    output:,
    jobs: options[:jobs],
    budget:,
    reporter:,
    prefix: header,
    tail:
  )
  result = header + reducer.run(head) + tail
  result = cleanup(result, output, oracle, failure, reporter) if budget.cleanup_allowed?
  reporter.stop(output)
rescue Interrupt
  warn "interrupted; keeping #{output}"
ensure
  File.write(output, result)
end

exit 130 if interrupt_state.interrupted?
